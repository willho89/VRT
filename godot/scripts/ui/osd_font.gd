class_name OsdFont
extends RefCounted
## Blocky 5x7 bitmap font for the TV's on-screen display, drawn for VRT
## (original glyphs). Each font pixel is drawn as a SCALE x SCALE block of OSD
## pixels, which gives the thick strokes of a 90s TV's character generator.

const W := 5
const H := 7
const SCALE := 2
const ADVANCE := (W + 1) * SCALE
const LINE := (H + 3) * SCALE
## Private glyphs: level-bar cells and the favourite star.
const BAR_FULL := "\u0001"
const BAR_EMPTY := "\u0002"
const STAR := "\u0003"

const GLYPHS := {
