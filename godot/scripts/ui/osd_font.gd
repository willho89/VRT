	"%": ["##..#", "##..#", "...#.", "..#..", ".#...", "#..##", "#..##"],
	"'": ["..#..", "..#..", ".#...", ".....", ".....", ".....", "....."],
	"(": ["...#.", "..#..", ".#...", ".#...", ".#...", "..#..", "...#."],
